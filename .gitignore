# =========================
.mcp.json
mcp_settings.local.json

# =========================
# Source corpus
#
# PDF files are kept local. Keep text corpus files and evaluation CSVs
# trackable so the GitHub repo can still show the paper RAG workflow
# without uploading large raw PDFs.
# =========================
data/**/*.pdf
# data/**/*.docx
# data/**/*.xlsx

# =========================
# Keep folder structure
# =========================
!data/.gitkeep
!index/.gitkeep
!logs/.gitkeep
!screenshots/.gitkeep
!notebooks/.gitkeep
